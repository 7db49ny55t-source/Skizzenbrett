{
  "name": "skizzenbrett",
  "productName": "Skizzenbrett",
  "version": "1.0.0",
  "description": "2D-CAD und CAM in Millimetern",
  "author": "Joshua",
  "main": "main.js",
  "private": true,
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "de.skizzenbrett.app",
    "productName": "Skizzenbrett",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "app/**", "build/icon.png"],
    "win": { "target": "nsis", "icon": "build/icon.png", "artifactName": "Skizzenbrett-Setup.${ext}" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true, "shortcutName": "Skizzenbrett" },
    "mac": { "target": "dir", "icon": "build/icon.png", "category": "public.app-category.graphics-design", "identity": null }
  }
}
